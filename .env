# ============================================================
# NeuroFleetX — Root .env for Docker Compose
# Copy this to .env and fill in your values before running:
#   docker-compose up --build
# NEVER commit the filled .env to Git.
# ============================================================

# MySQL
DB_USERNAME=neurofleetx
DB_PASSWORD=your_strong_password_here

# JWT (min 32 characters, change in production)
JWT_SECRET=ThisIsA256BitSecretKeyForNeuroFleetXChangeThisInProduction!!

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# App URLs
APP_URL=http://localhost:5173
APP_SUPPORT_EMAIL=support@neurofleetx.com
APP_NOREPLY_EMAIL=noreply@neurofleetx.com

# Razorpay
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_HERE
RAZORPAY_KEY_SECRET=YOUR_SECRET_HERE

# Google Maps (for map components)
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_KEY_HERE
