# ============================================================
# NeuroFleetX — Frontend Environment Variables (Vite)
# Copy this to .env.local for local dev
# NEVER commit .env.local to Git
# ============================================================

# Backend API base URL (no trailing slash)
VITE_API_URL=http://localhost:8082

# WebSocket URLs
VITE_WS_TELEMETRY_URL=http://localhost:8082/ws-telemetry
VITE_WS_MAINTENANCE_URL=http://localhost:8082/ws-maintenance

# Enable WebSocket (set to 'true' once backend is running)
VITE_ENABLE_WEBSOCKET=true

# Google Maps API Key (for RouteMap / FleetMap components)
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Razorpay Public Key (same rzp_test_ key, public side)
VITE_RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY
