# NeuroFleetX Frontend — Dockerfile
# Builds the Vite React app and serves with nginx

# Stage 1: Build
FROM node:20-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci --silent

COPY . .

# Pass env vars as build args so Vite can embed them
ARG VITE_API_URL=http://localhost:8080
ARG VITE_WS_TELEMETRY_URL=http://localhost:8080/ws-telemetry
ARG VITE_WS_MAINTENANCE_URL=http://localhost:8080/ws-maintenance
ARG VITE_ENABLE_WEBSOCKET=true
ARG VITE_RAZORPAY_KEY_ID=rzp_test_placeholder
ARG VITE_GOOGLE_MAPS_API_KEY=

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_WS_TELEMETRY_URL=$VITE_WS_TELEMETRY_URL
ENV VITE_WS_MAINTENANCE_URL=$VITE_WS_MAINTENANCE_URL
ENV VITE_ENABLE_WEBSOCKET=$VITE_ENABLE_WEBSOCKET
ENV VITE_RAZORPAY_KEY_ID=$VITE_RAZORPAY_KEY_ID
ENV VITE_GOOGLE_MAPS_API_KEY=$VITE_GOOGLE_MAPS_API_KEY

RUN npm run build

# Stage 2: Serve with nginx
FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html

# nginx config: route all paths to index.html (SPA support)
RUN printf 'server {\n\
  listen 5173;\n\
  root /usr/share/nginx/html;\n\
  index index.html;\n\
  location / {\n\
    try_files $uri $uri/ /index.html;\n\
  }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 5173

CMD ["nginx", "-g", "daemon off;"]
